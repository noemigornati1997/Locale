---
// LOGO SEGNAPOSTO: sostituite questo SVG con il logo definitivo (vale per header e footer).
// "porta" è il colore dell'arco interno, uguale allo sfondo su cui sta il logo.
import { SITE } from "../config.mjs";
import Segnaposto from "./Segnaposto.astro";
const { href = "/", porta = "#FFF8EF" } = Astro.props;
---
<a class="logo" href={href}>
  <svg viewBox="0 0 48 48" aria-hidden="true"><path d="M6 44V24C6 14 14 6 24 6s18 8 18 18v20z" fill="#B44A24"/><path d="M17 44V31a7 7 0 0 1 14 0v13z" fill={porta}/><path d="M11 18l4 5 4-6 5 6 5-6 4 6 4-5" fill="none" stroke="#E3B04B" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/><circle cx="24" cy="37.5" r="2.6" fill="#3F7566"/></svg>
  <span class="logo-nome"><Segnaposto valore={SITE.nome} /><small>{SITE.comune} centro</small></span>
</a>
